PORT=3000
# Optional bind address; leave unset to use the default host.
# HOST=
# Set to your real HTTPS origin before production deployment, for example https://www.your-domain.com
# SITE_URL=
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=replace-with-a-16-character-gmail-app-password
ADMIN_EMAIL=admin@example.com
# Optional local HTTPS certificate paths, relative to this project or absolute.
# Configure both to enable HTTPS; keep private keys out of Git.
# TLS_CERT_PATH=.certs/localhost.pem
# TLS_KEY_PATH=.certs/localhost-key.pem
