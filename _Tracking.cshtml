@* Include once in _Layout.cshtml just before </head>:  <partial name="_Tracking" />
   appsettings.json -> "Tracking": { "Ga4Id": "G-XXXXXXXXXX", "PixelId": "000000000000000", "AdSenseClient": "ca-pub-XXXXXXXXXXXXXXXX" } *@
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var ga4 = Config["Tracking:Ga4Id"];
    var pixel = Config["Tracking:PixelId"];
    var adsense = Config["Tracking:AdSenseClient"];
}

@if (!string.IsNullOrEmpty(ga4))
{
    <script async src="https://www.googletagmanager.com/gtag/js?id=@ga4"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '@ga4');
    </script>
}

@if (!string.IsNullOrEmpty(pixel))
{
    <script>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '@pixel');
        fbq('track', 'PageView');
    </script>
}

@if (!string.IsNullOrEmpty(adsense))
{
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=@adsense" crossorigin="anonymous"></script>
}

<script>
    // One helper so GA4 and Meta Pixel always receive the same event.
    // gn.track('add_to_cart', 'AddToCart', { value: 12.5, currency: 'NPR' })
    window.gn = {
        track: function (gaEvent, fbEvent, data) {
            if (window.gtag) gtag('event', gaEvent, data || {});
            if (window.fbq && fbEvent) fbq('track', fbEvent, data || {});
        }
    };
    // Click tracking for any element with data-track="event_name"
    document.addEventListener('click', function (e) {
        var el = e.target.closest('[data-track]');
        if (el) gn.track(el.dataset.track, null, { label: el.dataset.label || el.textContent.trim().slice(0, 40) });
    });
</script>
