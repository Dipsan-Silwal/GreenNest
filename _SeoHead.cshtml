@* In _Layout.cshtml <head>:  <partial name="_SeoHead" />
   In each view set ViewData["Title"], ["MetaDescription"], ["MetaKeywords"], ["OgImage"], optionally ["JsonLd"] *@
@{
    var title = (ViewData["Title"] as string) ?? "GreenNest";
    var desc = (ViewData["MetaDescription"] as string)
        ?? "GreenNest: smart gardening store with plants, tools and plant-care guidance in Nepal.";
    var keywords = (ViewData["MetaKeywords"] as string)
        ?? "indoor plants, gardening tools, plant care, buy plants online Nepal";
    var request = Context.Request;
    var canonical = $"{request.Scheme}://{request.Host}{request.Path}";
    var ogImage = (ViewData["OgImage"] as string) ?? $"{request.Scheme}://{request.Host}/images/og-default.jpg";
}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@title | GreenNest</title>
<meta name="description" content="@desc" />
<meta name="keywords" content="@keywords" />
<link rel="canonical" href="@canonical" />

<meta property="og:type" content="website" />
<meta property="og:title" content="@title | GreenNest" />
<meta property="og:description" content="@desc" />
<meta property="og:url" content="@canonical" />
<meta property="og:image" content="@ogImage" />
<meta name="twitter:card" content="summary_large_image" />

@if (ViewData["JsonLd"] is string jsonLd)
{
    <script type="application/ld+json">@Html.Raw(jsonLd)</script>
}

@* Alt text for product images:
   <img src="@p.ImageUrl" alt="@p.Name - @p.Category, buy online at GreenNest" loading="lazy" width="400" height="400" />
   Decorative images: alt="" *@
