@* Usage: <partial name="_AdSlot" model='"1234567890"' />  (model = ad slot id)
   data-adtest="on" keeps a demo site from generating invalid traffic; remove it in production. *@
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@model string
<ins class="adsbygoogle"
     style="display:block"
     data-ad-client="@Config["Tracking:AdSenseClient"]"
     data-ad-slot="@Model"
     data-ad-format="auto"
     data-full-width-responsive="true"
     data-adtest="on"></ins>
<script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
